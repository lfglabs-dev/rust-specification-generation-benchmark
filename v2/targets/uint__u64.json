 "intent": "Specify the public API of the one-limb unsigned integer `U64` generated by `uint::construct_uint! { pub struct U64(1); }` (module `ethereum_types::uint`): `overflowing_add`, `checked_add`, `overflowing_sub`, `checked_sub`, `overflowing_neg`, `checked_neg`, the `Add`/`Sub` operators (`impl<T: Into<U64>> Add<T>` / `Sub<T>`, e.g. with a `U64` or an `i32` right operand), `AddAssign`/`SubAssign`, `Not`, `BitAnd`, `BitOr`, `BitXor`, `PartialEq::eq`, `low_u32`, `low_u64`, `as_u64`, `is_zero`, `bits`, `bit`, `byte`, `zero`, `one`, `Default::default`, and the `From<u64>`, `From<u32>`, `From<i64>` and `From<i32>` conversions.",
 "manual_mutants": [
  {
   "decl": "ethereum_types.uint.U64.overflowing_neg",
   "before": "then ok (self, false)",
   "after": "then ok (self, true)",
   "note": "negating zero reported as an overflow (checked_neg(0) becomes None)"
  },
  {
   "decl": "ethereum_types.uint.U64.bits_loop.body",
   "before": "let i3 ← 64#usize - i2",
   "after": "let i3 ← 63#usize - i2",
   "note": "off-by-one in bits(); also panics on zero"
  },
  {
   "decl": "ethereum_types.uint.U64.bit",
   "before": "let i ← index / 64#usize",
   "after": "let i ← index / 65#usize",
   "note": "bit(64) no longer panics (returns bit 0)"
  },
  {
   "decl": "ethereum_types.uint.U64.byte",
   "before": "let i ← index / 8#usize",
   "after": "let i ← index / 9#usize",
   "note": "byte(8) no longer panics (returns byte 0)"
  },
  {
   "decl": "ethereum_types.uint.U64.Insts.CoreConvertFromI64.from",
   "before": "massert (value >= 0#i64)",
   "after": "massert (value > 0#i64)",
   "note": "From<i64>/From<i32> reject zero"
  },
  {
   "decl": "ethereum_types.uint.U64.Insts.CoreOpsArithAddTU64.add",
   "before": "massert (¬ overflow)",
   "after": "massert (overflow = overflow)",
   "note": "`+` wraps on overflow instead of panicking"
  },
  {
   "decl": "ethereum_types.uint.U64.Insts.CoreOpsArithSubAssignU64.sub_assign",
   "before": "massert (¬ overflow)",
   "after": "massert (overflow = overflow)",
   "note": "`-=` wraps on underflow instead of panicking"
  }
 ]
