 "intent": "Specify the public `varing::packable::Packable` impls for builtin integers: `pack` and `unpack` of `u64: Packable<u64, u128>`, `i64: Packable<i64, u128>`, `u32: Packable<i32, u64>`, `i32: Packable<u32, u64>`, `u32: Packable<u64, u128>`, `u64: Packable<u32, u128>`, `i16: Packable<i64, u128>`, `i64: Packable<i16, u128>`, `u16: Packable<i32, u64>`, `i32: Packable<u16, u64>`, `i8: Packable<u64, u128>` and `u64: Packable<i8, u128>`.",
 "manual_mutants": [
  {
   "decl": "varing.packable.builtin.unpack_u32_u64",
   "before": "let i2 ← lift (UScalar.cast .U64 large)",
   "after": "let i2 ← (if large.val < 2^64 then ok (UScalar.cast .U64 large) else fail .panic)",
   "note": "u64::try_from(large).unwrap(): unpack panics when bits >= 96 are set instead of ignoring them"
  },
  {
   "decl": "varing.packable.builtin.unpack_u16_u32",
   "before": "let i2 ← lift (UScalar.cast .U32 large)",
   "after": "let i2 ← (if large.val < 2^32 then ok (UScalar.cast .U32 large) else fail .panic)",
   "note": "u32::try_from(large).unwrap(): unpack panics when bits >= 48 are set"
  },
  {
   "decl": "varing.packable.builtin.pack_u16_u64",
   "before": "let i ← large <<< core.num.U16.BITS",
   "after": "let i ← large <<< core.num.U8.BITS",
   "note": "copy-paste: shifts the wide field by 8 instead of 16 bits"
  },
  {
   "decl": "varing.utils.zigzag_decode_i8",
   "before": "let i ← value >>> 1#i32",
   "after": "let i ← (do let s ← (UScalar.hcast .I8 value) >>> 1#i32; ok (IScalar.hcast .U8 s))",
   "note": "arithmetic instead of logical shift in i8 ZigZag decode"
  },
  {
   "note": "i32/u32 impl puts the i32 in the low half (consistent round trip, but not the layout of u32: Packable<i32>)",
   "edits": [
    {
     "decl": "varing.packable.builtin.pack_i32_u32",
     "before": "packable.builtin.pack_u32_i32 b a",
     "after": "(do let z ← utils.zigzag_encode_i32 a; packable.builtin.pack_u32 z b)"
    },
    {
     "decl": "varing.packable.builtin.unpack_i32_u32",
     "before": "let (a, b) ← packable.builtin.unpack_u32_i32 packed",
     "after": "let (a, b) ← (do let (lo, hi) ← packable.builtin.unpack_u32 packed; let x ← utils.zigzag_decode_i32 lo; ok (hi, x))"
    }
   ]
  },
  {
   "decl": "varing.utils.zigzag_encode_i64",
   "before": "let i ← value <<< 1#i32",
   "after": "let i ← value * 2#i64",
   "note": "checked multiplication in ZigZag encode: panics for |v| >= 2^62"
  }
 ]
}
