   "before": "if secs <= 1833029933770#i64",
   "after": "if secs <= 1844674407370#i64",
   "note": "upper bound forgets the epoch offset: late times panic on overflow instead of returning Err(Overflow)"
  },
  {
   "decl": "nt_time.file_time.unix_time.FileTime.from_unix_time_secs",
   "before": "error.FileTimeRangeErrorKind.Overflow",
