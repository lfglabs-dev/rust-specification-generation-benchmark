 "intent": "Specify the public API of `crdts::dot` for `u8` actors: `Dot::new`, `Dot::inc`, `Dot::apply_inc`, `From<(A, u64)> for Dot`, `Clone`, `PartialEq` and `PartialOrd` of `Dot`, the `Clone`/`PartialEq`/`PartialOrd`/`Ord` implementations of `OrdDot`, and the `From` conversions between `Dot` and `OrdDot`.",
 "manual_mutants": [
  {
   "decl": "crdts.dot.Dot.inc",
   "before": "let i ← self.counter + 1#u64",
   "after": "let i ← (if self.counter.val = 2^64 - 1 then ok 0#u64 else self.counter + 1#u64)",
   "note": "successor wraps instead of panicking at u64::MAX"
  },
  {
   "decl": "crdts.dot.Dot.Insts.CoreCmpPartialOrdDot.partial_cmp",
   "before": "if b",
   "after": "if true",
   "note": "dots of different actors become comparable by counter"
  },
  {
   "decl": "crdts.dot.OrdDot.Insts.CoreCmpPartialOrdOrdDot.partial_cmp",
   "before": "| core.cmp.Ordering.Greater => ok o",
   "after": "| core.cmp.Ordering.Greater => ok (core.option.Option.Some core.cmp.Ordering.Less)",
   "note": "derived partial order wrong when the actor is greater"
  },
  {
   "decl": "crdts.dot.OrdDot.Insts.CoreCmpOrd.cmp",
   "before": "core.U64.Insts.CoreCmpOrd.cmp self.counter other.counter",
   "after": "core.U64.Insts.CoreCmpOrd.cmp other.counter self.counter",
   "note": "counter tie-break reversed for equal actors"
  },
  {
   "decl": "crdts.dot.OrdDot.Insts.CoreCmpPartialEqOrdDot.eq",
   "before": "then corecmpPartialEqInst.eq self.actor other.actor",
   "after": "then ok true",
   "note": "equality ignores the actor"
  },
  {
   "decl": "crdts.dot.Dot.apply_inc",
   "before": "let i ← self.counter + 1#u64",
   "after": "let i ← self.counter + (if self.counter.val = 0 then 2#u64 else 1#u64)",
   "note": "wrong increment from zero"
  },
  {
   "decl": "crdts.dot.Dot.Insts.CoreCmpPartialEqDot.eq",
   "before": "if b",
   "after": "if true",
   "note": "Dot equality ignores the actor"
  },
  {
   "decl": "crdts.dot.OrdDot.Insts.CoreConvertFromDot.from",
   "before": "ok { actor := d.actor, counter := d.counter }",
   "after": "ok { actor := d.actor, counter := (if d.counter.val = 2^64 - 1 then 0#u64 else d.counter) }",
   "note": "conversion to OrdDot wraps the maximal counter to 0"
  }
 ],
 "bug_variants": [
  {
   "id": "inj1",
   "kind": "injected",
   "source": "injected regression (promoted manual mutant #1); no usable historical fix found upstream",
   "note": "Dot::partial_cmp drops the same-actor check: dots of different actors become comparable by their counters, although dots of different actors are causally unrelated (partial order must return None)",
