 "intent": "Specify the public API of the Goldilocks prime field crate `goldilocks_ntt::field`: the field element type `Field` with `Field::new`, the conversions `From<u64>`, `From<u128>`, `From<i32>` for `Field` and `From<Field>` / `From<&Field>` for `u64`, the operators `Add`, `AddAssign`, `Sub`, `SubAssign`, `Neg`, `Mul`, `MulAssign`, `Div`, `DivAssign`, `Shl<u64>`, `ShlAssign<u64>`, `Shr<u64>`, `ShrAssign<u64>`, `Field::inv`, `Field::pow`, `Field::root`, and the trait impls `Ord::cmp`, `PartialOrd::partial_cmp`, `PartialEq::eq`, `Default::default`, `Clone::clone`; and the raw `u64` arithmetic of `field::algo` (`algo::generic`): `add`, `sub`, `mul`, `mont_mul`, `mont_reduce_128`, `reduce_64`, `reduce_128`, `mont_pow`, `inv`, `shift` and `root_384`. In the extraction `Field` is (reducibly) `Std.U64`; the `*Assign` operators take `&mut self` and return its final value.",
 "manual_mutants": [
  {
   "decl": "goldilocks_ntt.field.Field.new",
   "before": "massert (value < field.Field.MODULUS)",
   "after": "massert (value <= field.Field.MODULUS)",
   "note": "Field::new accepts MODULUS itself (off-by-one in the range assertion)"
  },
  {
   "decl": "goldilocks_ntt.field.algo.generic.reduce_64",
   "before": "if n > field.algo.MODULUS",
   "after": "if n > 18446744069414584322#u64",
   "note": "reduce_64 leaves MODULUS + 1 unreduced (From<u64> still correct: mont_mul absorbs it)"
  },
  {
   "decl": "goldilocks_ntt.field.Field.inv",
   "before": "let i1 \u2190 field.algo.generic.mont_mul i field.algo.MONT_R3",
   "after": "let i1 \u2190 field.algo.generic.mont_mul i field.algo.MONT_R2",
   "note": "inverse converted back with R^2 instead of R^3: inv(0) = 0 still holds, x * inv(x) is not one"
  },
  {
   "decl": "goldilocks_ntt.field.Field.root",
   "before": "if order = 0#u64",
   "after": "if false",
   "note": "missing zero check: root(0) panics (division by zero) instead of returning None"
  },
  {
   "decl": "goldilocks_ntt.field.algo.generic.shift",
   "before": "| 48#uscalar => field.algo.generic.shift_48 a",
   "after": "| 48#uscalar => field.algo.generic.shift_32 a",
   "note": "fast path for n = 48 dispatches to the wrong helper"
  },
  {
   "decl": "goldilocks_ntt.field.Field.Insts.CoreOpsBitShrU64Field.shr",
   "before": "let i \u2190 rhs % 192#u64",
   "after": "let i \u2190 rhs % 96#u64",
   "note": "right shift reduces the amount modulo 96 instead of 192 (sign flips for n mod 192 >= 96)"
  },
  {
   "decl": "goldilocks_ntt.field.algo.generic.mont_pow",
   "before": "field.algo.generic.mont_pow_loop a e field.algo.MONT_R1",
   "after": "field.algo.generic.mont_pow_loop a e 1#u64",
   "note": "accumulator starts at raw 1 instead of the Montgomery one (results scaled by R^-1)"
  },
  {
   "note": "Ord compares the internal (Montgomery) representations instead of the canonical values; equality unaffected",
   "edits": [
    {
     "decl": "goldilocks_ntt.field.Field.Insts.CoreCmpOrd.cmp",
