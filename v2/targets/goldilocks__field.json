 "bug_variants": [
  {
   "id": "bug1",
   "kind": "historical",
   "source": "https://github.com/recmo/goldilocks/commit/444d7bf (\"Use montgomery form\": `a = MODULUS - a` -> `a = sub(0, a)` in algo::generic::shift)",
   "note": "shift(a, n) negated with `MODULUS - a` for odd n / 96: for a = 0 and n = 96 (mod 192) it returns MODULUS, a non-canonical zero (shift must return a reduced value equal to a * 2^n mod P); through Field this makes zero << 96 (and zero >> 96) compare unequal to zero. The pre-fix tree predates the crate reorganisation and cannot be extracted with the same --start-from, so the single changed line is transcribed in extraction style.",
   "edits": [
    {
     "decl": "goldilocks_ntt.field.algo.generic.shift",
     "before": "then field.algo.generic.sub 0#u64 a",
     "after": "then field.algo.MODULUS - a"
    }
   ]
  }
 ]
