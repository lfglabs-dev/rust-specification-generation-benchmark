   "after": "core.num.U16.from_be_bytes (Array.make 2#usize [ i7, i6 ])",
   "note": "sender_address_valid_length byte order swapped"
  },
  {
   "decl": "etherparse.link.linux_sll_header.LinuxSllHeader.to_bytes",
