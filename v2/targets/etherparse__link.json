   "after": "U16.Insts.CoreConvertFromArpHardwareId.from self.arp_hrd_type",
   "note": "protocol field serialised from the ARP id"
  },
  {
   "decl": "etherparse.link.linux_nonstandard_ether_type.LinuxNonstandardEtherType.Insts.CoreConvertTryFromU16Tuple.try_from",
   "before": "| 15#uscalar => ok (core.result.Result.Err ())",
   "after": "| 15#uscalar => ok (core.result.Result.Ok 15#u16)",
   "note": "the unassigned id 0x000F is accepted as a non-standard ether type"
  },
  {
   "decl": "etherparse.link.linux_sll_packet_type.LinuxSllPacketType.Insts.CoreConvertTryFromU16HeaderError.try_from",
