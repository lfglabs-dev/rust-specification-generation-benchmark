   "before": "source := (Array.make 6#usize [ i6, i7, i8, i9, i10, i11 ]),",
   "after": "source := (Array.make 6#usize [ i, i1, i2, i3, i4, i5 ]),",
   "note": "source parsed from the destination bytes"
  },
  {
