 "intent": "Specify the public integer-value API of `lilliput_core`: the zig-zag coding traits `ToZigZag`/`FromZigZag` for `i8`, `i16`, `i32`, `i64` and for `SignedIntValue` (to `UnsignedIntValue`), the `PartialEq`/`Ord`/`PartialOrd`/`Default`/`From` implementations of `SignedIntValue` and `UnsignedIntValue`, and `IntValue::is_signed`, `IntValue::default` and the `From<i8|i16|i32|i64|u8|u16|u32|u64|usize>` conversions into `IntValue`.",
 "manual_mutants": [
  {
   "decl": "lilliput_core.I16.Insts.Lilliput_coreNumZigzagToZigZagU16.to_zig_zag",
   "before": "let i1 ← i - 1#usize",
   "after": "let i1 ← i - 2#usize",
   "note": "sign mask shift off by one: wrong only for large-magnitude negative i16"
  },
  {
   "edits": [
    {
     "decl": "lilliput_core.I8.Insts.Lilliput_coreNumZigzagToZigZagU8.to_zig_zag",
     "before": "let i2 ← self >>> i1",
     "after": "let i2u ← lift (IScalar.hcast .U8 self)"
    },
    {
     "decl": "lilliput_core.I8.Insts.Lilliput_coreNumZigzagToZigZagU8.to_zig_zag",
     "before": "let i3 ← lift (IScalar.hcast .U8 i2)",
     "after": "let i3 ← i2u >>> i1"
    }
   ],
   "note": "logical instead of arithmetic shift for the sign mask: wrong for negative i8"
  },
  {
   "edits": [
    {
     "decl": "lilliput_core.I32.Insts.Lilliput_coreNumZigzagFromZigZagU32.from_zig_zag",
     "before": "let i ← zig_zag >>> 1#i32",
     "after": "let i ← lift (UScalar.hcast .I32 zig_zag)"
    },
    {
     "decl": "lilliput_core.I32.Insts.Lilliput_coreNumZigzagFromZigZagU32.from_zig_zag",
     "before": "let i1 ← lift (UScalar.hcast .I32 i)",
     "after": "let i1 ← i >>> 1#i32"
    }
   ],
   "note": "decode shifts after the signed cast (arithmetic shift): wrong for codes >= 2^31"
  },
  {
   "decl": "lilliput_core.value.int.signed.SignedIntValue.canonicalized",
   "before": "| value.int.signed.SignedIntValue.I64 value1 => ok value1",
   "after": "| value.int.signed.SignedIntValue.I64 value1 => ok (IScalar.cast .I64 (IScalar.cast .I32 value1))",
   "note": "ordering truncates 64-bit payloads"
  },
  {
   "decl": "lilliput_core.value.int.unsigned.UnsignedIntValue.canonicalized",
   "before": "| value.int.unsigned.UnsignedIntValue.U64 value1 => ok value1",
   "after": "| value.int.unsigned.UnsignedIntValue.U64 value1 => ok (UScalar.cast .U64 (UScalar.cast .U32 value1))",
   "note": "ordering truncates 64-bit payloads"
  },
  {
   "decl": "lilliput_core.value.int.signed.SignedIntValue.Insts.CoreCmpPartialEqSignedIntValue.eq",
   "before": "ok (lhs = rhs)",
   "after": "ok (IScalar.cast .I32 lhs = IScalar.cast .I32 rhs)",
   "note": "equality only compares the low 32 bits"
  },
  {
   "decl": "lilliput_core.I64.Insts.Lilliput_coreNumZigzagFromZigZagU64.from_zig_zag",
   "before": "let i4 ← -. i3",
   "after": "let i4 ← ok (0#i64 : Std.I64)",
   "note": "sign of odd codes dropped: odd codes decode as non-negative"
  }
 ],
 "sibling_mutants": [
  {
   "decl": "lilliput_core.value.int.signed.SignedIntValue.Insts.CoreDefaultDefault.default",
   "before": "ok (value.int.signed.SignedIntValue.I8 0#i8)",
   "after": "ok (value.int.signed.SignedIntValue.I64 0#i64)",
   "note": "default signed zero stored at 64 bits"
  },
  {
   "decl": "lilliput_core.value.int.unsigned.UnsignedIntValue.Insts.CoreDefaultDefault.default",
   "before": "ok (value.int.unsigned.UnsignedIntValue.U8 0#u8)",
   "after": "ok (value.int.unsigned.UnsignedIntValue.U32 0#u32)",
   "note": "default unsigned zero stored at 32 bits"
  },
  {
   "decl": "lilliput_core.value.int.IntValue.Insts.CoreDefaultDefault.default",
   "before": "ok (value.int.IntValue.Unsigned uiv)",
   "after": "ok (value.int.IntValue.Signed (value.int.signed.SignedIntValue.I8 0#i8))",
   "note": "default IntValue is a signed zero"
  }
