 "intent": "Specify the public fixed-width big-integer API of `crypto_bigint::Uint<LIMBS>` (little-endian 64-bit limbs) included in this extraction: `Uint::carrying_add`, `adc`, `wrapping_add`, `borrowing_sub`, `sbb`, `wrapping_sub`, `sub_mod`, `sub_mod_special`, `bitand`, `bitand_limb`, `wrapping_and`, `bitor`, `wrapping_or`, `bitxor`, `wrapping_xor`, `from_le_slice`, `from_be_slice` and `new`, and the limb primitives `Limb::carrying_add`, `Limb::overflowing_add`, `Limb::borrowing_sub`, `Limb::bitand`, `Limb::bitor` and `Limb::bitxor`.",
 "manual_mutants": [
  {
   "decl": "crypto_bigint.primitives.borrowing_sub",
   "before": "let i ← core.num.U64.BITS - 1#u32",
   "after": "let i ← core.num.U64.BITS - 2#u32",
   "note": "incoming borrow read from bit 62 instead of the top bit: chained borrows (MAX) still work, an explicit borrow word 2^63 is ignored"
  },
  {
   "decl": "crypto_bigint.primitives.carrying_add",
   "before": "ok (i1, i3)",
   "after": "ok (i1, if i3 > 0#u64 then 1#u64 else 0#u64)",
   "note": "carry word clamped to 1: wrong only when a large incoming carry makes the limb sum exceed 2^65"
  },
  {
   "decl": "crypto_bigint.uint.encoding.Uint.from_le_slice_loop0_loop0.body",
   "before": "let i2 ← i1 + j",
   "after": "let i2 ← (do let k ← 7#usize - j; i1 + k)",
   "note": "bytes within each limb read in big-endian order by from_le_slice"
  },
  {
   "decl": "crypto_bigint.primitives.borrowing_sub",
   "before": "let i3 ← core.num.U64.wrapping_sub core.num.U64.MIN i2",
   "after": "let i3 ← ok i2",
   "note": "borrow word 1 instead of MAX: single-limb results fine, the borrow is lost between limbs"
  },
  {
   "decl": "crypto_bigint.uint.encoding.Uint.from_le_slice",
   "before": "massert (i = i1)",
   "after": "massert (i >= i1)",
   "note": "from_le_slice accepts over-long slices (silently ignoring the extra bytes) instead of panicking"
  },
  {
   "decl": "crypto_bigint.primitives.borrowing_sub",
   "before": "let i2 ← lift (UScalar.cast_fromBool .U64 (b1 || b2))",
   "after": "let i2 ← lift (UScalar.cast_fromBool .U64 b1)",
   "note": "borrow lost when the limb is 0 and a borrow comes in (only visible with rippling borrows)"
  }
