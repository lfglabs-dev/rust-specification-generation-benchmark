   "after": "let i4 ← lift (IScalar.cast_fromBool .I64 (self > 0#i32))",
   "note": "zero treated as negative"
  },
  {
   "decl": "tinyset.I16.Insts.TinysetSet64Fits64.from_u64",
   "before": "let i1 ← lift (~~~ i)",
   "after": "let i1 ← lift (~~~ x)",
   "note": "negative value computed from the unshifted word"
  },
  {
   "decl": "tinyset.U32.Insts.TinysetSet64Fits64.from_u64",
   "before": "ok (UScalar.cast .U32 x)",
   "after": "ok (UScalar.cast .U32 (UScalar.cast .U16 x))",
   "note": "decoding truncates through u16"
  },
  {
   "decl": "tinyset.U16.Insts.TinysetSet64Fits64.to_u64",
   "before": "ok (UScalar.cast .U64 self)",
   "after": "ok (UScalar.cast .U64 (UScalar.cast .U8 self))",
   "note": "encoding truncates through u8"
  },
  {
   "decl": "tinyset.I64.Insts.TinysetSet64Fits64.from_u64",
   "before": "let pos_val ← lift (UScalar.hcast .I64 i)",
   "after": "let pos_val ← lift (UScalar.hcast .I64 (UScalar.cast .U32 i))",
   "note": "large non-negative i64 decoded through 32 bits"
  },
  {
   "decl": "tinyset.I16.Insts.TinysetSet64Fits64.to_u64",
   "before": "let neg_rep ← lift (i2 ||| 1#u64)",
   "after": "let neg_rep ← lift (i2)",
   "note": "tag bit for negatives forgotten"
  },
  {
   "decl": "tinyset.Isize.Insts.TinysetSet64Fits64.to_u64",
   "before": "let i4 ← lift (IScalar.cast_fromBool .I64 (self >= 0#isize))",
   "after": "let i4 ← lift (IScalar.cast_fromBool .I64 (self >= -1#isize))",
   "note": "-1 encoded as non-negative"
  }
