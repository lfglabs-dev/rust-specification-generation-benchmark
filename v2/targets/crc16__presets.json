 "upstream_props": [],
 "intent": "Specify the public API of the `crc16` crate (0.4.0): the generic `State<T: CrcType>` with `State::new()`, `update(&mut self, msg: &[u8])`, `get(&self) -> u16`, `State::calculate(msg) -> u16`, `Default::default()` and the `core::hash::Hasher` methods `write`/`finish`, together with the `CrcType` implementations (`init`, `update`, `get`) of the types `ARC`, `AUG_CCITT`, `BUYPASS`, `CDMA2000`, `DECT_R`, `DNP`, `EN_13757`, `MCRF4XX`, `T10_DIF`, `TELEDISK`. In Lean, `State.new inst`, `State.update inst s msg` (returns the updated state), `State.get inst s`, `State.calculate inst msg`, `State.Insts.CoreHashHasher.write/finish inst \u2026`, `State.Insts.CoreDefaultDefault.default inst`, where `inst` is e.g. `ARC.Insts.Crc16CrcType`; messages are `Slice Std.U8`. (The remaining types of the crate are out of scope.)",
 "manual_mutants": [
  {
   "note": "AUG-CCITT direct-to-augmented init conversion runs 15 instead of 16 steps",
   "decl": "crc16.AUG_CCITT.Insts.Crc16CrcType.init",
   "before": "AUG_CCITT.Insts.Crc16CrcType.init_loop { start := 0#i32, \u00abend\u00bb := 16#i32 }",
   "after": "AUG_CCITT.Insts.Crc16CrcType.init_loop { start := 0#i32, \u00abend\u00bb := 15#i32 }"
  },
  {
   "note": "ARC get flushes only one zero byte through the augmented register",
   "decl": "crc16.ARC.Insts.Crc16CrcType.get",
   "before": "ARC.Insts.Crc16CrcType.get_loop { start := 0#i32, \u00abend\u00bb := 2#i32 } crc",
   "after": "ARC.Insts.Crc16CrcType.get_loop { start := 0#i32, \u00abend\u00bb := 1#i32 } crc"
  },
  {
   "note": "DECT-R forgets its final xor 0x0001",
   "decl": "crc16.DECT_R.Insts.Crc16CrcType.get",
   "before": "ok (crc1 ^^^ 1#u16)",
   "after": "ok crc1"
  },
  {
   "note": "MCRF4XX reflected init: bytes of the bit-reversed register swapped back",
   "decl": "crc16.MCRF4XX.Insts.Crc16CrcType.init",
   "before": "let i3 \u2190 i2 <<< 8#i32",
   "after": "let i3 \u2190 ok i2"
  },
  {
   "note": "CDMA2000 update indexes the table with the low byte of the register",
   "decl": "crc16.CDMA2000.Insts.Crc16CrcType.update_loop.body",
   "before": "let i5 \u2190 crc >>> 8#i32",
   "after": "let i5 \u2190 ok crc"
  },
  {
   "note": "State::update discards the new register (update is a no-op)",
   "decl": "crc16.State.update",
   "before": "ok { self with state := i }",
   "after": "ok self"
  }
 ],
