def packable.builtin.unpack_u8_u16
  (packed : Std.U32) : RustM (Std.U8 × Std.U16) := do
  let i ← 1#u32 <<< core.num.U8.BITS
  let small_mask ← i - 1#u32
  let small ← lift (packed &&& small_mask)
  let large ← packed >>> core.num.U8.BITS
  let i1 ← lift (UScalar.cast .U8 small)
  let i2 ← lift (UScalar.cast .U16 large)
  ok (i1, i2)

