  ok (days1, i11, i12, i13)

/-- [datealgo::dhms_to_secs]:
    Source: 'src/lib.rs', lines 732:0-742:1
    Visibility: public -/
def dhms_to_secs
  (t : (Std.I32 × Std.U8 × Std.U8 × Std.U8)) : RustM Std.I64 := do
  let (d, h, m, s) := t
  let i ← RD_MIN
  massert (d >= i)
  let i1 ← RD_MAX
  massert (d <= i1)
  massert (h >= consts.HOUR_MIN)
  massert (h <= consts.HOUR_MAX)
  massert (m >= consts.MINUTE_MIN)
  massert (m <= consts.MINUTE_MAX)
  massert (s >= consts.SECOND_MIN)
  massert (s <= consts.SECOND_MAX)
  if d >= i
  then
    if d <= i1
    then
      let i2 ← lift (IScalar.cast .I64 d)
      let i3 ← i2 * SECS_IN_DAY
      let i4 ← lift (UScalar.hcast .I64 h)
      let i5 ← i4 * 3600#i64
      let i6 ← i3 + i5
      let i7 ← lift (UScalar.hcast .I64 m)
      let i8 ← i7 * 60#i64
      let i9 ← i6 + i8
      let i10 ← lift (UScalar.hcast .I64 s)
      i9 + i10
    else ok 0#i64
  else ok 0#i64

/-- [datealgo::secs_to_datetime]:
    Source: 'src/lib.rs', lines 771:0-775:1
    Visibility: public -/
def secs_to_datetime
  (secs : Std.I64) :
  RustM (Std.I32 × Std.U8 × Std.U8 × Std.U8 × Std.U8 × Std.U8)
  := do
  let (days, hh, mm, ss) ← secs_to_dhms secs
  let (y, m, s) ← rd_to_date days
  ok (y, m, s, hh, mm, ss)

/-- [datealgo::datetime_to_secs]:
    Source: 'src/lib.rs', lines 808:0-811:1
    Visibility: public -/
def datetime_to_secs
  (t : (Std.I32 × Std.U8 × Std.U8 × Std.U8 × Std.U8 × Std.U8)) :
  RustM Std.I64
  := do
  let (y, m, d, hh, mm, ss) := t
  let days ← date_to_rd (y, m, d)
  dhms_to_secs (days, hh, mm, ss)

/-- [datealgo::rd_to_isoweekdate]:
    Source: 'src/lib.rs', lines 924:0-932:1
    Visibility: public -/
def rd_to_isoweekdate
  (rd : Std.I32) : RustM (Std.I32 × Std.U8 × Std.U8) := do
  let i ← RD_MIN
  massert (rd >= i)
  let i1 ← RD_MAX
  massert (rd <= i1)
  let wd ← rd_to_weekday rd
  let i2 ← lift (UScalar.hcast .I32 wd)
  let i3 ← 4#i32 - i2
  let i4 ← i3 % 7#i32
  let rdt ← rd + i4
  let (y, _, _) ← rd_to_date rdt
  let ys ← date_to_rd (y, 1#u8, 1#u8)
  let i5 ← rdt - ys
  let i6 ← i5 / 7#i32
  let w ← i6 + 1#i32
  let i7 ← lift (IScalar.hcast .U8 w)
  ok (y, i7, wd)

/-- [datealgo::isoweeks_in_year]:
    Source: 'src/lib.rs', lines 1100:0-1109:1
    Visibility: public -/
def isoweeks_in_year (y : Std.I32) : RustM Std.U8 := do
  massert (y >= YEAR_MIN)
  massert (y <= YEAR_MAX)
  let wd ← date_to_weekday (y, 1#u8, 1#u8)
  let l ← is_leap_year y
  match wd with
  | 4#uscalar => ok 53#u8
  | 3#uscalar => if l
                 then ok 53#u8
                 else ok 52#u8
  | _ => ok 52#u8

/-- [datealgo::isoweekdate_to_rd]:
    Source: 'src/lib.rs', lines 972:0-987:1
    Visibility: public -/
def isoweekdate_to_rd (t : (Std.I32 × Std.U8 × Std.U8)) : RustM Std.I32 := do
  let (y, w, d) := t
  massert (y >= YEAR_MIN)
  massert (y <= YEAR_MAX)
  massert (w >= consts.WEEK_MIN)
  let i ← isoweeks_in_year y
  massert (w <= i)
  massert (d >= consts.WEEKDAY_MIN)
  massert (d <= consts.WEEKDAY_MAX)
  if y != YEAR_MAX
  then ok ()
  else if w != consts.WEEK_MAX
       then ok ()
       else massert (d <= consts.THURSDAY)
  let rd4 ← date_to_rd (y, 1#u8, 4#u8)
  let wd4 ← rd_to_weekday rd4
  let i1 ← wd4 - 1#u8
  let i2 ← lift (UScalar.hcast .I32 i1)
  let ys ← rd4 - i2
  let i3 ← lift (UScalar.hcast .I32 w)
  let i4 ← i3 - 1#i32
  let i5 ← i4 * 7#i32
  let i6 ← ys + i5
  let i7 ← lift (UScalar.hcast .I32 d)
  let i8 ← i7 - 1#i32
  i6 + i8

/-- [datealgo::date_to_isoweekdate]:
    Source: 'src/lib.rs', lines 1025:0-1028:1
    Visibility: public -/
def date_to_isoweekdate
  (t : (Std.I32 × Std.U8 × Std.U8)) :
  RustM (Std.I32 × Std.U8 × Std.U8)
  := do
  let rd ← date_to_rd t
  rd_to_isoweekdate rd

/-- [datealgo::isoweekdate_to_date]:
    Source: 'src/lib.rs', lines 1067:0-1070:1
    Visibility: public -/
def isoweekdate_to_date
  (t : (Std.I32 × Std.U8 × Std.U8)) :
  RustM (Std.I32 × Std.U8 × Std.U8)
  := do
  let rd ← isoweekdate_to_rd t
  rd_to_date rd

end datealgo
